# Ignore dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Testing and coverage
coverage/

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# Environment Variables (Keep secrets out of version control)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*.suo
*.njsproj
*.sln

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Oracle / DB exports and temp files
*.dmp
*.log

# Playwright MCP session artifacts (snapshots, screenshots, console dumps).
# These are generated by the playwright-mcp browser-automation tool during
# bug-hunt / UX-test runs and should never be committed — every browse
# session creates dozens of timestamped files.
.playwright-mcp/

# Ad-hoc test screenshots from manual / automated UX runs (e.g. test-01-…,
# ux-03-…). Real screenshots that belong in docs/ should be checked in
# explicitly with a meaningful name.
test-*.png
ux-*.png

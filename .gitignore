# Ignore dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Testing and coverage
coverage/

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# Environment Variables (Keep secrets out of version control)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*.suo
*.njsproj
*.sln

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Oracle / DB exports and temp files
*.dmp
*.log

# Playwright MCP session artifacts (snapshots, screenshots, console dumps).
# These are generated by the playwright-mcp browser-automation tool during
# bug-hunt / UX-test runs and should never be committed — every browse
# session creates dozens of timestamped files.
.playwright-mcp/

# Ad-hoc test screenshots from manual / automated UX / bug-hunt runs.
# These accumulate fast (Playwright takes a new one every other step), and
# none of them are intended for the repo. Real screenshots that belong in
# docs/ go under docs/ — anything at the repo root is by definition a
# diagnostic. The `/` anchor scopes the wildcard to the repo root so
# legitimate PNGs in docs/, frontend/public/, etc. still pass through.
test-*.png
ux-*.png
/*.png

# Stray root-level package files. The real frontend project lives at
# frontend/ — anything matching at the repo root is almost always npm
# running from the wrong directory and creates a phantom workspace root
# that breaks Turbopack's tailwind resolution (the "two lockfiles, picked
# the parent" warning).
/package.json
/package-lock.json
/node_modules/
